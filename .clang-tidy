---
# Rule set for `est`. Tuned to allocator-heavy code and intrusive
# waiter-list pointers owned outside a smart pointer.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  cppcoreguidelines-*,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-do-while,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-redundant-declaration

# cppcoreguidelines-avoid-do-while: off because Catch2's REQUIRE/CHECK
# macros expand to a do-while at the call site, which header filtering
# can't suppress.
#
# readability-redundant-declaration: off because two interdependent
# partitions that both reach <new> (directly or transitively) make
# Clang's module-aware analysis see operator new/delete declared via two
# global-module-fragment paths and flag it as redundant - a false
# positive inherent to how modules work, not a real duplicate.

WarningsAsErrors: '*'
# Anchored so it only matches an actual est/ or examples/ path component
# (unanchored 'est/' would also match e.g. a build directory named
# "build-test/" containing "est/" as a substring).
HeaderFilterRegex: '(^|/)(est|examples)/'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
