+        // mps2an385: same steady_clock gap as catch_timer.cpp's own
+        // patch (this bare-metal libc++ build has no OS-provided
+        // monotonic clock) - a trivial stand-in Clock satisfying the
+        // named requirement (Rep/Period/duration/time_point/is_steady/
+        // now()), not a real one. Not used unless BENCHMARK() macros are
+        // actually exercised, which this project's own test suite doesn't.
+#if defined(CATCH_BAREMETAL_NO_MONOTONIC_CLOCK)
+        struct default_clock {
+            using rep = std::uint64_t;
+            using period = std::nano;
+            using duration = std::chrono::duration<rep, period>;
+            using time_point = std::chrono::time_point<default_clock>;
+            static constexpr bool is_steady = false;
+            static auto now() noexcept -> time_point { return time_point{}; }
+        };
+#else
         using default_clock = std::chrono::steady_clock;
+#endif
     } // namespace Benchmark
 } // namespace Catch
 
